{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "opener",
  "description": "Permission to open folders and paths",
  "windows": [
    "main"
  ],
  "permissions": [
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}