# Node
node_modules
.eslintcache

# Build outputs
dist
out

# Logs (exact ".log" suffix only — "*.log*" would also match the MappingUtility.Logging
# project directory on case-insensitive filesystems, since git for Windows folds ".Logging"
# to ".logging" when matching)
*.log

# OS
.DS_Store
Thumbs.db

# C# (anchored to the actual project roots so an unanchored "bin/"/"obj/" doesn't also match
# app/resources/bin below, which has its own dedicated ignore rule for a different reason)
/MappingUtility.Server/bin/
/MappingUtility.Server/obj/
/MappingUtility.Parser/bin/
/MappingUtility.Parser/obj/
/MappingUtility.Logging/bin/
/MappingUtility.Logging/obj/
.vs/
*.user

# Generated by `pnpm run publish:backend` (dotnet publish output), not committed
/app/resources/server/

# External CLI tools (ffmpeg, yt-dlp, deno, waifu2x-ncnn-vulkan) fetched from their official
# distribution channels by `app/scripts/fetch-bin.mjs` (runs via postinstall) — too large
# (~600MB combined) to commit, and not ours to redistribute via git anyway.
/app/resources/bin/

# Original
example/
