{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "downloader",
  "description": "Permissions for video/audio downloader (yt-dlp, ffmpeg)",
  "windows": [
    "main"
  ],
  "permissions": [
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": [
            "--js-runtimes",
            "deno",
            "--newline",
            "--no-color",
            "--encoding",
            "utf-8",
            "-f",
            "bestaudio",
            "--no-playlist",
            "--windows-filenames",
            "--trim-filenames",
            {
              "validator": "^[0-9]{1,3}$"
            },
            "--path",
            {
              "validator": ".+"
            },
            "--output",
            "%(title)s-audio-src.%(ext)s",
            "--print",
            "after_move:filepath",
            {
              "validator": "^https?://.+"
            }
          ]
        },
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": [
            "--js-runtimes",
            "deno",
            "--newline",
            "--no-color",
            "--encoding",
            "utf-8",
            "--no-playlist",
            "--windows-filenames",
            "--trim-filenames",
            {
              "validator": "^[0-9]{1,3}$"
            },
            "-f",
            "bestvideo[ext=mp4]/bestvideo",
            "--path",
            {
              "validator": ".+"
            },
            "--output",
            "%(title)s-background.%(ext)s",
            "--print",
            "after_move:filepath",
            {
              "validator": "^https?://.+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-i",
            {
              "validator": ".+"
            },
            "-f",
            "null",
            "-"
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-c:a",
            {
              "validator": "^(libmp3lame|libvorbis)$"
            },
            "-b:a",
            {
              "validator": "^[0-9]+k$"
            },
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-an",
            "-c:v",
            "copy",
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-vf",
            {
              "validator": "^scale=[0-9]+:[0-9]+$"
            },
            "-q:v",
            {
              "validator": "^[0-9]{1,2}$"
            },
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-i",
            {
              "validator": ".+"
            },
            "-filter_complex",
            {
              "validator": "^\\[0\\]split=3\\[blur\\]\\[scale\\]\\[output\\];\\[output\\]scale=1280:720\\[output\\];\\[scale\\]scale=-1:340\\[scale\\];\\[blur\\]scale=1280:-1,boxblur=10,crop=1280:340\\[blur\\];\\[output\\]\\[1\\]overlay=0:0\\[output\\];\\[output\\]\\[blur\\]overlay=0:387\\[output\\];\\[output\\]\\[scale\\]overlay=\\(W-w\\)/2:387\\[output\\]$"
            },
            "-map",
            "[output]",
            "-aspect",
            "1280:720",
            "-b:v",
            "800K",
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "waifu2x-ncnn-vulkan",
          "sidecar": true,
          "args": [
            "-i",
            {
              "validator": ".+"
            },
            "-o",
            {
              "validator": ".+"
            },
            "-s",
            {
              "validator": "^[0-9]+$"
            },
            "-n",
            {
              "validator": "^[0-9]+$"
            },
            "-m",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
