{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "downloader",
  "description": "Permissions for video/audio downloader (yt-dlp, ffmpeg)",
  "windows": [
    "main"
  ],
  "permissions": [
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": [
            "--newline",
            "--no-color",
            "--encoding",
            "utf-8",
            "-f",
            "bestaudio",
            "--no-playlist",
            "--windows-filenames",
            "--trim-filenames",
            {
              "validator": "^[0-9]{1,3}$"
            },
            "--path",
            {
              "validator": ".+"
            },
            "--output",
            "%(title)s-audio-src.%(ext)s",
            "--print",
            "after_move:filepath",
            {
              "validator": "^https?://.+"
            }
          ]
        },
        {
          "name": "yt-dlp",
          "sidecar": true,
          "args": [
            "--newline",
            "--no-color",
            "--encoding",
            "utf-8",
            "--no-playlist",
            "--windows-filenames",
            "--trim-filenames",
            {
              "validator": "^[0-9]{1,3}$"
            },
            "-f",
            "bestvideo[ext=mp4]/bestvideo",
            "--path",
            {
              "validator": ".+"
            },
            "--output",
            "%(title)s-background.%(ext)s",
            {
              "validator": "^https?://.+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-i",
            {
              "validator": ".+"
            },
            "-f",
            "null",
            "-"
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-c:a",
            {
              "validator": "^(libmp3lame|libvorbis)$"
            },
            "-b:a",
            {
              "validator": "^[0-9]+k$"
            },
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "ffmpeg",
          "sidecar": true,
          "args": [
            "-y",
            "-i",
            {
              "validator": ".+"
            },
            "-an",
            "-c:v",
            "copy",
            {
              "validator": ".+"
            }
          ]
        },
        {
          "name": "waifu2x-ncnn-vulkan",
          "sidecar": true,
          "args": [
            "-i",
            {
              "validator": ".+"
            },
            "-o",
            {
              "validator": ".+"
            },
            "-s",
            {
              "validator": "^[0-9]+$"
            },
            "-n",
            {
              "validator": "^[0-9]+$"
            }
          ]
        }
      ]
    }
  ]
}