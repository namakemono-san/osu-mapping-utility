{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu! mapping utility",
  "version": "0.5.1",
  "identifier": "osu-mapping-utility",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "osu! mapping utility",
        "decorations": false,
        "transparent": false,
        "fullscreen": false,
        "resizable": false,
        "dragDropEnabled": true,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "script-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": []
        }
      },
      "capabilities": [
        "default",
        "opener",
        "desktop-capability",
        "downloader"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "binaries/models-cunet/*",
      "binaries/models-upconv_7_anime_style_art_rgb/*",
      "binaries/models-upconv_7_photo/*",
      "binaries/vcomp140.dll"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/waifu2x-ncnn-vulkan"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERERTQ2MzI4REExMTUyRQpSV1F1RmFHTk1rYmVEWUh2RkhEcUp2SXEybFgrZ0xLVktpaW1nMVNhUU5ZTFFnclFUVGVKZjRkbgo=",
      "endpoints": [
        "https://github.com/namakemono-san/osu-mapping-utility/releases/latest/download/latest.json"
      ]
    }
  }
}
