{
  "name": "osu-mapping-utility",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "pnpm --filter app tauri dev",
    "build": "pnpm --filter app tauri build",
    "check": "pnpm --filter app typecheck && dotnet build MappingUtility.sln --nologo -v q",
    "knip": "pnpm --filter app knip",
    "add:app": "pnpm --filter app add",
    "remove:app": "pnpm --filter app remove"
  },
  "devDependencies": {}
}
